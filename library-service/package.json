{
  "name": "book-club-library-service",
  "version": "1.0.0",
  "description": "Servicio de autenticación y gestión de usuarios del Book Club",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
