// gamification-service/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// =====================================================
// ESTADÍSTICAS DEL USUARIO
// =====================================================

model UserStats {
  id                String   @id @default(uuid())
  userId            String   @unique
  
  // Experiencia y Nivel
  totalXP           Int      @default(0)
  currentLevel      Int      @default(1)
  xpForNextLevel    Int      @default(100)
  
  // Estadísticas de lectura
  totalPagesRead    Int      @default(0)
  totalBooksRead    Int      @default(0)
  totalBooksStarted Int      @default(0)
  
  // Racha (streak)
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastReadDate      DateTime?
  
  // Tiempo
  totalReadingTime  Int      @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
  @@map("user_stats")
}

// =====================================================
// LOGROS/ACHIEVEMENTS
// =====================================================

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String   @db.Text
  icon        String?
  category    AchievementCategory @default(READING)
  
  requirement String   @db.Text
  xpReward    Int      @default(0)
  
  rarity      AchievementRarity @default(COMMON)
  
  createdAt   DateTime @default(now())
  
  userAchievements UserAchievement[]
  
  @@index([category])
  @@index([rarity])
  @@map("achievements")
}

// =====================================================
// LOGROS DESBLOQUEADOS
// =====================================================

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  
  unlockedAt    DateTime @default(now())
  
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

// =====================================================
// ACTIVIDAD DIARIA (Para racha)
// =====================================================

model ReadingActivity {
  id          String   @id @default(uuid())
  userId      String
  
  // ✅ SIN @default(now()) para evitar error MySQL
  date        DateTime @db.Date
  
  pagesRead   Int      @default(0)
  minutesRead Int      @default(0)
  booksRead   String   @db.Text
  
  createdAt   DateTime @default(now())
  
  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("reading_activities")
}

// =====================================================
// ENUMS
// =====================================================

enum AchievementCategory {
  READING
  COLLECTION
  SOCIAL
  STREAK
  SPECIAL
}

enum AchievementRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}