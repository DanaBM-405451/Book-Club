# =====================================================
# CHAT SERVICE - Environment Variables Template
# =====================================================

# Server
NODE_ENV=development
PORT=3020
SERVICE_NAME=chat-service

# Database (MySQL)
DATABASE_URL="mysql://bookclub_admin:Dead0Alive97@127.0.0.1:3312/chat_db?connect_timeout=30&pool_timeout=30&socket_timeout=30"
SHADOW_DATABASE_URL=""

# JWT Secret (debe ser el MISMO que auth-service)
JWT_SECRET=123456789
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Microservices URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
LIBRARY_SERVICE_URL=http://localhost:3003
GAMIFICATION_SERVICE_URL=http://localhost:3004
SOCIAL_SERVICE_URL=http://localhost:3005

# Gateway & Frontend
GATEWAY_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3001

# Socket.io
SOCKET_IO_PATH=/socket.io
SOCKET_IO_PING_TIMEOUT=60000
SOCKET_IO_PING_INTERVAL=25000

# Logs
LOG_LEVEL=debug