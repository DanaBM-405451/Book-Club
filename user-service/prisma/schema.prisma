// =====================================================
// USER_BD - user-service/prisma/schema.prisma
// Base de datos para perfiles y configuración
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Profile {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id") // Referencia a User en auth-service
  
  // Información personal
  nombre         String?   @map("first_name") @db.VarChar(100)
  apellido       String?   @map("last_name") @db.VarChar(100)
  nickName       String?   @map("display_name") @db.VarChar(150) // Nombre que se muestra
  bio            String?   @db.Text
  
  // Fecha de nacimiento
  birthDate       DateTime? @map("birth_date") @db.Date
  
  // Ubicación
  pais         String?   @db.VarChar(100)
  provincia        String?   @db.VarChar(100) // Estado/Provincia
  ciudad           String?   @db.VarChar(100)
  
  // Coordenadas para Google Maps (opcional)
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  
  // Avatar
  avatarType      AvatarType @default(DEFAULT) @map("avatar_type")
  avatarUrl       String?   @map("avatar_url") @db.VarChar(1000) // URL de Cloudinary
  defaultAvatar   String?   @map("default_avatar") @db.VarChar(50) // "avatar_01.png"
  
  // Preferencias de lectura
  favoriteGeneros  String?   @map("favorite_generos") @db.Text // "Fantasy, Thriller, Romance"
  readingGoal      Int?      @map("reading_goal") // Libros por año
  
  // Privacidad
  isProfilePublic Boolean   @default(true) @map("is_profile_public")
  showLocation    Boolean   @default(false) @map("show_location")
  showStats       Boolean   @default(true) @map("show_stats")
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([pais])
  @@index([ciudad])
  @@map("profiles")
}

// Configuración de notificaciones
model NotificationSettings {
  id              Int       @id @default(autoincrement())
  userId          String    @unique @map("user_id")
  
  // Preferencias de notificaciones
  emailEnabled    Boolean   @default(true) @map("email_enabled")
  pushEnabled     Boolean   @default(true) @map("push_enabled")
  
  // Tipos de notificaciones
  friendRequests  Boolean   @default(true) @map("friend_requests")
  groupInvites    Boolean   @default(true) @map("group_invites")
  newMessages     Boolean   @default(true) @map("new_messages")
  readingReminders Boolean  @default(true) @map("reading_reminders")
  achievements    Boolean   @default(true) @map("achievements")
  
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("notification_settings")
}

// Tokens de dispositivos para push notifications
model DeviceToken {
  id              Int       @id @default(autoincrement())
  userId          String    @map("user_id")
  token           String    @unique @db.VarChar(500) // FCM token
  deviceType      String    @map("device_type") @db.VarChar(50) // "android", "ios", "web"
  deviceName      String?   @map("device_name") @db.VarChar(100) // "iPhone 13", "Chrome Desktop"
  isActive        Boolean   @default(true) @map("is_active")
  
  createdAt       DateTime  @default(now()) @map("created_at")
  lastUsedAt      DateTime  @default(now()) @map("last_used_at")

  @@index([userId])
  @@map("device_tokens")
}

enum AvatarType {
  DEFAULT         // Avatar predeterminado del sistema
  UPLOADED        // Imagen subida por el usuario
 
}
