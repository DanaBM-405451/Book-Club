# .env.example (en la raíz del proyecto)

# =====================================================
# MYSQL - Bases de Datos
# =====================================================
MYSQL_ROOT_PASSWORD=root_password_123
MYSQL_USER=bookclub_user
MYSQL_PASSWORD=bookclub_pass_456

# =====================================================
# JWT - Autenticación
# =====================================================
JWT_SECRET=tu_secret_super_seguro_aqui_cambialo
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# =====================================================
# PUERTOS - Servicios
# =====================================================
AUTH_DB_PORT=3307
USER_DB_PORT=3308
LIBRARY_DB_PORT=3309

AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
LIBRARY_SERVICE_PORT=3003

API_GATEWAY_PORT=8082  
FRONTEND_PORT=3100

# =====================================================
# URLs INTERNAS (Docker Network)
# =====================================================
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
LIBRARY_SERVICE_URL=http://library-service:3003

# =====================================================
# URLs EXTERNAS (Frontend - Navegador)
# =====================================================
NEXT_PUBLIC_API_URL=http://localhost:8082  

# =====================================================
# CLOUDINARY
# =====================================================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_UPLOAD_PRESET=book_club_preset

# =====================================================
# GOOGLE APIs
# =====================================================
GOOGLE_BOOKS_API_KEY=tu_google_books_key
GOOGLE_MAPS_API_KEY=tu_google_maps_key

# =====================================================
# DESARROLLO
# =====================================================
NODE_ENV=development
CORS_ORIGIN=http://localhost:3100  # URL del frontend
LOG_LEVEL=debug