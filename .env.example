# =====================================================
# BOOK CLUB - Variables de Entorno
# =====================================================

# =====================================================
# MYSQL - Bases de Datos
# =====================================================
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# =====================================================
# JWT - Autenticación
# =====================================================
# Genera un secret fuerte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# =====================================================
# PUERTOS - Servicios
# =====================================================
# Bases de datos (acceso externo desde tu PC)
AUTH_DB_PORT=3307
USER_DB_PORT=3308
LIBRARY_DB_PORT=3309

# Microservicios
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
LIBRARY_SERVICE_PORT=3003

# Gateway
API_GATEWAY_PORT=8080

# Frontend
FRONTEND_PORT=3000

# =====================================================
# URLs INTERNAS (Docker Network)
# =====================================================
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
LIBRARY_SERVICE_URL=http://library-service:3003

# =====================================================
# URLs EXTERNAS (Frontend)
# =====================================================
NEXT_PUBLIC_API_URL=http://localhost:8080

# =====================================================
# CLOUDINARY - Almacenamiento de Archivos
# =====================================================
# Obtener en: https://cloudinary.com/console
# IMPORTANTE: Crear cuenta ANTES de llenar estos campos (no te olvides)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=book_club_preset

# =====================================================
# GOOGLE APIs
# =====================================================
# Google Books API
# Obtener en: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Google Maps API (para usuarios cercanos)
# Obtener en: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# =====================================================
# FIREBASE - Push Notifications (PWA)
# =====================================================
# Obtener en: https://console.firebase.google.com/
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# =====================================================
# DESARROLLO
# =====================================================
NODE_ENV=development

# CORS - Permitir frontend
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# =====================================================
# PRODUCCIÓN (si lo llego a desplegar)
# =====================================================
# Descomentar y llenar al deployar en Railway/Vercel

# PRODUCTION_DB_URL=mysql://user:password@host:port/database
# PRODUCTION_API_URL=https://tu-api.railway.app
# PRODUCTION_FRONTEND_URL=https://tu-app.vercel.app